{
  "name": "resume-ranker",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev:up": "docker compose up -d postgres",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
