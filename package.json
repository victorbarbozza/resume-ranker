{
  "name": "resume-ranker",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts",
    "user:create": "bun src/create-user.ts",
    "dev:up": "docker compose up -d --wait postgres",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v --remove-orphans && rm -rf data/files"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.114",
    "@ai-sdk/openai-compatible": "^3.0.82",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@hono/node-server": "^2.1.6",
    "@hono/typebox-validator": "^1.1.0",
    "@tanstack/react-query": "^5.105.0",
    "ai": "^7.0.159",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "hono": "^4.13.16",
    "mammoth": "^1.13.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "typebox": "^1.4.3",
    "unpdf": "^2.1.0",
    "unstorage": "^1.17.6"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
